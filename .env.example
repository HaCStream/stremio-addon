DEBUG_LEVEL=INFO
DEV_UI_ENABLED=true
DEV_UI_HOST=0.0.0.0
# SKIP_DEV_UI_AUTH=false
# Optional custom Developer UI password; blank uses ADDON_ACCESS_KEY.
# DEV_UI_PASSWORD=
ADDON_URL=https://telegram.example.com
ADDON_ACCESS_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS
TELEGRAM_APP_API_ID=123456
TELEGRAM_APP_API_HASH=YOUR_TELEGRAM_APP_API_HASH
USER_SESSION_STRING=YOUR_TELETHON_STRING_SESSION
# CACHE_MB=512
# Delay after a completed scan cycle; ongoing backlogs continue promptly.
# SCAN_INTERVAL_SECONDS=300
# CHANNEL_IDS=-1001234567890,-1009876543210
# Show Telegram collections on the main screen; search remains available when false.
# DISPLAY_COLLECTION=false
# DATA_DIR=/data
# AI_SEARCH_ENABLED=false
# GEMINI_API_KEY=
# Require a separate final AI word (case insensitive) before calling Gemini.
# Append it when finished typing, e.g. someone relives the same day AI
# REQUIRE_AI_SUFFIX_FOR_AI_SEARCH=true

# Optional TMDB v3 API key: match shows to public catalog episode sources.
# TMDB_API_KEY=



# Number of Telegram channels or groups scanned concurrently.
# INDEXING_CONCURRENCY=2
